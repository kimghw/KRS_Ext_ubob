{
  "manifest_version": 3,
  "name": "유밥 자동 학습 도우미",
  "short_name": "유밥 자동학습",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "ubob.com 계정으로 자동 로그인해 수강 중인 과정 목록을 가져오고, 보이지 않는 백그라운드 플레이어에서 미완료 강의를 배속으로 끝까지 자동 재생합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "notifications", "offscreen", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.ubob.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "유밥 자동 학습 도우미",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.ubob.com/*"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.ubob.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
